# ---- AIDRA Configuration ----
# Copy to .env and fill in real values

# === Database ===
DB_PASSWORD=changeme_strong_password_here
DATABASE_URL=postgresql+asyncpg://aidra:${DB_PASSWORD}@aidra-db:5432/aidra

# === Copernicus Data Space ===
# Register at https://dataspace.copernicus.eu (free)
COPERNICUS_USER=your_email@example.com
COPERNICUS_PASSWORD=your_copernicus_password
# Aggregate download ceiling in Mbps, shared by the 4 parallel connections
# (0 = unlimited). At ~50 Mbps the OCI VNIC starts dropping inbound packets
# and every service on the host times out; 20 Mbps keeps a 1.9 GB scene at
# ~13 min. See src/config.py:download_rate_limit_mbps.
DOWNLOAD_RATE_LIMIT_MBPS=20

# === Grafana ===
GRAFANA_PASSWORD=changeme_grafana_admin
# Set to true only for public demo deployments where anyone may view dashboards.
GRAFANA_ANONYMOUS_ENABLED=false
GRAFANA_ANONYMOUS_ORG_NAME=Main Org.

# === API Protection ===
# Optional bearer token required for POST/PATCH/PUT/DELETE under /api.
# Leave empty for local development; set a strong random value in production.
AIDRA_API_TOKEN=

# === Directories ===
MODELS_DIR=/app/models
IMAGES_DIR=/data/images

# === Pipeline Defaults ===
DEFAULT_ZONE=gibraltar
DEFAULT_MODEL=vesseltracker-sar-yolov8
DEFAULT_MODEL_VERSION=v1.0
DEFAULT_PROFILE=ground
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# === CFAR Defaults ===
# Window geometry that production has ALWAYS run (ModelManager ignored these
# keys until 2026-08-29 and used the CFARDetector defaults 8/20). Since
# commit e2c8de1 they drive the detector: keep 8/20 unless a benchmarked
# triplet says otherwise. 3/15 here would silently change production.
CFAR_GUARD_SIZE=8
CFAR_TRAINING_SIZE=20
CFAR_PFA=1e-5

# === Tile Defaults ===
TILE_SIZE=640
TILE_OVERLAP=64

# === Tip & Cue ===
TIPCUE_ENABLED=true
TIPCUE_MIN_CONFIDENCE=0.7
TIPCUE_MIN_DETECTIONS=2
TIPCUE_COOLDOWN_MINUTES=60

# === Scheduler ===
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=6

# === Observability ===
PROMETHEUS_ENABLED=true
LOKI_URL=http://aidra-loki:3100
# Push HTTP directo a Loki desde la app. No hay Promtail en ningun entorno
# (montar docker.sock en host compartido quedo descartado), asi que esta es
# la unica via de ingesta: a false, Loki queda vacio e I-TRACE-3 sin cumplir.
LOKI_ENABLED=true
LOG_LEVEL=INFO

# === Limits ===
MAX_IMAGE_SIZE_GB=2.0
MAX_CONCURRENT_PIPELINES=1
PIPELINE_TIMEOUT_SECONDS=600

# === Acceso remoto al despliegue (solo lectura desde fuera; nunca SSH) ===
# Grafana: admin + datasource proxy => SQL libre sobre PostGIS,
#   PromQL sobre Prometheus, LogQL sobre Loki.
#   POST {GRAFANA_URL}/api/ds/query  (uids: PostgreSQL / Prometheus / Loki)
GRAFANA_URL=https://aidra.uliber.com
# API publica de AIDRA (health, pipeline/status, traceability, OGC, STAC)
AIDRA_API_URL=https://aidra-api.uliber.com
# Coolify: estado de contenedores, historial de despliegues, compose efectivo.
#   El token empieza por "N|" — MANTENER ENTRECOMILLADO o el `source` del
#   shell lo parte por el pipe y las llamadas devuelven 401.
COOLIFY_URL=https://cool.uliber.com
COOLIFY_ROOT_API_TOKEN="changeme_coolify_token"
